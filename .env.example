# Lokalny PostgreSQL (zainstalowany i uruchomiony osobno).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mieszkania
PORT=3001
HOST=0.0.0.0
# Puste = proxy Vite, działa także z telefonu w sieci lokalnej.
VITE_API_URL=
# false wyłącza automatyczne przetwarzanie kolejki (np. podczas testów).
AUTOMATION_ENABLED=true

# Opcjonalne logowanie do wspólnej bazy. Najpierw: npm run auth:user
AUTH_ENABLED=false
AUTH_COOKIE_SECURE=false
# Przy HTTPS/tunelu: pełny adres strony bez końcowego ukośnika.
APP_ORIGIN=
