{
  "name": "mieszkania-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "docker:dev": "node scripts/docker-dev.mjs",
    "auth:user": "node --import tsx apps/api/src/scripts/auth-user.ts",
    "prices:recalculate": "node --import tsx apps/api/src/scripts/maintenance/recalculate-unit-prices.ts",
    "facts:backfill-portals": "node --import tsx apps/api/src/scripts/maintenance/backfill-portal-facts.ts",
    "dev": "concurrently --kill-others-on-fail --names shared,web,api \"npm run dev -w @mieszkania/shared\" \"npm run dev -w @mieszkania/web\" \"npm run dev -w @mieszkania/api\"",
    "dev:web": "npm run dev -w @mieszkania/web",
    "dev:api": "npm run dev -w @mieszkania/api",
    "build": "npm run build -w @mieszkania/shared && npm run build -w @mieszkania/web && npm run build -w @mieszkania/api",
    "typecheck": "npm run typecheck -w @mieszkania/shared && npm run typecheck -w @mieszkania/web && npm run typecheck -w @mieszkania/api",
    "storage:report": "npm run storage:report -w @mieszkania/api",
    "storage:db-report": "npm run storage:db-report -w @mieszkania/api",
    "storage:db-compact": "npm run storage:db-compact -w @mieszkania/api --",
    "storage:db-reclaim": "npm run storage:db-reclaim -w @mieszkania/api --",
    "storage:migrate": "npm run storage:migrate -w @mieszkania/api --",
    "years:backfill": "npm run years:backfill -w @mieszkania/api --",
    "duplicates:backfill-facts": "npm run duplicates:backfill-facts -w @mieszkania/api --",
    "years:backfill-adresowo": "npm run years:backfill-adresowo -w @mieszkania/api --",
    "years:queue-refresh": "npm run years:queue-refresh -w @mieszkania/api --",
    "media:deduplicate": "npm run media:deduplicate -w @mieszkania/api --",
    "ids:repair-otodom": "npm run ids:repair-otodom -w @mieszkania/api --",
    "postinstall": "npm run build -w @mieszkania/shared && node scripts/ensure-browser.mjs",
    "predev": "node scripts/prepare-dev.mjs",
    "setup": "node scripts/prepare-dev.mjs",
    "pretest": "npm run build -w @mieszkania/shared",
    "test": "npm run test -w @mieszkania/api && npm run test -w @mieszkania/web",
    "format": "prettier --write apps packages scripts docs README.md AGENTS.md *.json",
    "format:check": "prettier --check apps packages scripts docs README.md AGENTS.md *.json",
    "setup:browser": "node scripts/ensure-browser.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
